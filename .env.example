# Documentation only. The companion reads process.env, not this file automatically.
# Prefer GitHub Codespaces / Actions secrets. NEVER use VITE_ prefixes for secrets.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DASHBOARD_ENCRYPTION_KEY=
# Same namespace in the Codespace and scheduler. One agent per namespace.
DASHBOARD_NAMESPACE=agent
CODESPACES_TOKEN=
# In Codespaces this is supplied by GitHub; set the Actions repository variable.
# CODESPACE_NAME=

# Optional Facebook Page bridge, disabled by default. Keep port 3000 PRIVATE.
MESSENGER_ENABLED=0
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_GRAPH_VERSION=
MESSENGER_ALLOWED_PSIDS=
MESSENGER_AGENT_ID=main
